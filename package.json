{
  "name": "metwesh-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "biome lint .",
    "format": "biome format --write . && biome check --write .",
    "format:check": "biome format . && biome check .",
    "compile": "tsc --noEmit && echo 'Compilation successful!'",
    "system:check": "biome check .",
    "system:fix": "yarn lint && yarn format && yarn compile",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "prepare": "husky"
  },
  "dependencies": {
    "@hashintel/refractive": "^0.0.4",
    "@react-spring/three": "^10.1.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@biomejs/biome": "^2.5.13",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/devtools": "^0.7.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.11.22",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^5.0.0"
  }
}
